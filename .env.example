# ---- Runtime mode ---------------------------------------------------------
# DEMO_MODE=true exposes a predictable demo login and synthetic mailboxes that
# run through the REAL pipeline. It must be false in any environment with real data. The one deployed exception
# is a password-protected public demo with synthetic mail only: see infra/docker/compose.staging.yml.
# To run with real mail, see docs/self-hosting.md.
DEMO_MODE=true

# ---- Database -------------------------------------------------------------
DATABASE_URL=postgres://localhost:5432/aegis_dev

# ---- Web ------------------------------------------------------------------
APP_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost
# true shows the public product site at /. Off, / goes straight to sign-in, as a self-hosted instance wants.
AEGIS_MARKETING_SITE=false

# ---- Key management -------------------------------------------------------
# LocalDevKms: a 32-byte base64 root key. DEV ONLY. Production must use a real
# KMS/HSM provider (see docs/architecture.md and docs/adr/0004).
# If unset in DEMO_MODE, a key is generated into .dev-keys/ (git-ignored).
AEGIS_DEV_ROOT_KEY=
# Production root of trust: a key you generate with `openssl rand -base64 32` (or AEGIS_ROOT_KEY_FILE
# pointing at a file holding it). Back it up apart from the database and never change it. See docs/self-hosting.md.
AEGIS_ROOT_KEY=
AEGIS_ROOT_KEY_FILE=
# Or AWS KMS instead of AEGIS_ROOT_KEY (not both). Written against AWS documentation; verify before relying on it.
AWS_KMS_KEY_ID=
AWS_REGION=

# ---- Google mailbox connection (Gmail API) — optional ----------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_AUDIENCE=
# The service account Pub/Sub signs push requests as. Required: tokens from any other account are refused.
GOOGLE_PUBSUB_SERVICE_ACCOUNT=

# ---- Microsoft mailbox connection (Graph) — optional -----------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_WEBHOOK_URL=

# ---- Hosted AI — optional, OFF unless configured AND enabled by the user ----
ANTHROPIC_API_KEY=
AEGIS_LLM_MODEL=claude-opus-5-5
# Optional: route to your own Anthropic-compatible endpoint instead.
AEGIS_LLM_BASE_URL=

# ---- Semantic search — optional, OFF unless set to "local" ------------------
# Runs a small sentence-embedding model (Xenova/all-MiniLM-L6-v2, quantized) inside the web and worker processes, on a thread that
# can be killed. Set it on both, or search can't embed a query. It stores one sealed vector per message for mailboxes with server search on.
# No mail text leaves the server, and ONNX Runtime's telemetry is turned off for you: see docs/privacy-modes.md.
# Each process that loads the model also loads about 23 MB of weights, and the native runtime on top. See docs/bench.md for what was measured.
# AEGIS_EMBEDDINGS=local
# Where the model is read from. With this set, nothing is ever downloaded and a missing model is an error. Use this in production:
#   <dir>/Xenova/all-MiniLM-L6-v2/{config.json,tokenizer.json,tokenizer_config.json,onnx/model_quantized.onnx}
# Without it, those files (about 23 MB) download once from huggingface.co, and each process start asks there for one small config file.
# AEGIS_EMBEDDINGS_MODEL_DIR=
# Where a download is cached. Defaults to .cache/embeddings at the repo root, which must be writable.
# AEGIS_EMBEDDINGS_CACHE_DIR=
# CPU threads the model uses for each embedding.
# AEGIS_EMBEDDINGS_THREADS=2

# ---- Malware scanning — optional -------------------------------------------
# clamd INSTREAM endpoint. Without it, attachments report "not scanned by a
# maintained engine" and evidence completeness is reduced; never "safe".
CLAMD_HOST=
CLAMD_PORT=3310

# ---- Platform operators -----------------------------------------------------
# Comma-separated addresses of existing, verified accounts. Applied by `pnpm operators sync`, on the migrating connection, not at
# web boot: no web or worker login can grant operator access. /admin also needs MFA on the account. See docs/runbooks/operators.md.
AEGIS_PLATFORM_ADMINS=

# ---- Sign-up -------------------------------------------------------------------
# invite: the first account, then only addresses with a pending invitation (the default with NODE_ENV=production outside demo mode).
# open: anyone who can reach the server (the default in development and demo mode).
# AEGIS_SIGNUP=invite

# ---- Instance limits — optional, no limits unless set ------------------------
# Server-wide defaults for every workspace. Unset or empty means no limit. A whole number of zero or more; anything else stops the
# server from starting. Operators can set a different limit, or no limit, for one workspace in /admin. Safety features are never limited.
# Connected mailboxes per person:
# AEGIS_LIMIT_ACCOUNTS=
# Hosted AI actions per workspace per calendar month:
# AEGIS_LIMIT_AI_ACTIONS_PER_MONTH=
# Rules per person:
# AEGIS_LIMIT_AUTOMATIONS=
# Members per workspace, pending invitations included:
# AEGIS_LIMIT_SEATS=
# Search index size per workspace, in bytes:
# AEGIS_LIMIT_INDEX_BYTES=

# ---- Transactional mail: optional in development, needed in production ------
# Verification, password reset and invitation mail. Sent by the worker. TLS is required unless the relay is on this machine.
# Without these in production, flows that need email say so and stop. In DEMO_MODE, mail goes to /dev/outbox instead.
# In local development with neither set, mail is recorded but there's nowhere to read it, so use DEMO_MODE=true.
TRANSACTIONAL_SMTP_URL=
TRANSACTIONAL_FROM=

# ---- Product sign-in with Google or Microsoft: optional ---------------------
# Separate from the mailbox clients above: these ask only for identity (openid email profile), never for mail.
# Redirect URI: <APP_ORIGIN>/api/v1/auth/sso/callback
# Microsoft: add the xms_edov optional claim, or nobody can create an account. Its plain email claim isn't verified.
SIGNIN_GOOGLE_CLIENT_ID=
SIGNIN_GOOGLE_CLIENT_SECRET=
SIGNIN_MICROSOFT_CLIENT_ID=
SIGNIN_MICROSOFT_CLIENT_SECRET=

# ---- Process database logins ------------------------------------------------
# web and worker connect as separate non-superuser roles (migration 003). `pnpm db:migrate` creates passwordless local
# logins for development. Production must provision its own and set both; there's no fallback to an owner connection.
DATABASE_URL_WEB=postgres://aegis_web_login@localhost:5432/aegis_dev
DATABASE_URL_WORKER=postgres://aegis_worker_login@localhost:5432/aegis_dev

# The restore operator's login, for `pnpm restore:reapply`. A member of aegis_restore_conn. Only that command uses it, so keep it out
# of the running processes. Without it, local development uses aegis_restore_login; production requires it.
# DATABASE_URL_RESTORE=postgres://aegis_restore_login@localhost:5432/aegis_dev

# ---- Deletion log: required in production -----------------------------------
# Where the worker ships the log that lets a restore re-apply deletions. See docs/runbooks/backup-restore.md. An absolute path, whose
# directory must exist. A production worker refuses to boot without it. Without it in development, rows just wait in the outbox.
# This ONLY counts as "outside the database" if it's on separate storage. On the database's own volume, it's lost with the database,
# and everything in it comes back on a restore. Point it at a mount with its own failure domain and administrators, and replicate it.
# It re-applies deletions to a restored database. It doesn't reach into a backup, which stays readable until it expires.
# AEGIS_DELETION_LOG_PATH=/mnt/deletion-log/deletions.jsonl
