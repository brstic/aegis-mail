# Settings for the self-hosted stack in compose.yaml. Copy to .env at the repository root and fill in.
#   cp infra/docker/selfhost.env.example .env && chmod 600 .env
# Every variable is described in docs/self-hosting.md. Lines left empty switch that feature off.

# ---- Required ----------------------------------------------------------------
# The public https address people open, with no trailing slash, and its host name.
APP_ORIGIN=https://mail.example.com
WEBAUTHN_RP_ID=mail.example.com

# Database passwords. Use URL-safe values, for example: openssl rand -hex 32
POSTGRES_PASSWORD=
AEGIS_WEB_DB_PASSWORD=
AEGIS_WORKER_DB_PASSWORD=

# Root key for envelope encryption: it wraps every workspace key. Generate it once with
#   openssl rand -base64 32
# and back it up somewhere other than the database backups. Losing it makes stored mail unreadable;
# changing it later does too. Instead of the value, AEGIS_ROOT_KEY_FILE can point at a file (e.g. a Docker secret).
AEGIS_ROOT_KEY=

# Alternative: AWS KMS holds the root key instead (leave AEGIS_ROOT_KEY empty). Credentials can also come
# from an instance or task role, in which case leave the two access keys empty.
AWS_KMS_KEY_ID=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Strongly recommended ---------------------------------------------------
# Verification, password reset and invitation mail. TLS is required unless the relay is on this machine.
#   smtps://user:password@smtp.example.com:465   or   smtp://user:password@smtp.example.com:587 (STARTTLS)
TRANSACTIONAL_SMTP_URL=
TRANSACTIONAL_FROM="Aegis Mail <no-reply@example.com>"

# Where the worker writes the deletion log. Empty uses a Docker volume; a host path on separate storage is better.
AEGIS_DELETION_LOG_DIR=

# ---- Mailbox connections (optional) -----------------------------------------
# IMAP and SMTP mailboxes (iCloud, Fastmail, Yahoo, your own server) need nothing here.
# Gmail: redirect URI <APP_ORIGIN>/api/v1/oauth/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
# Outlook and Microsoft 365: redirect URI <APP_ORIGIN>/api/v1/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_WEBHOOK_URL=

# ---- Sign in with Google or Microsoft (optional) ----------------------------
# Separate clients from the mailbox ones. Redirect URI <APP_ORIGIN>/api/v1/auth/sso/callback
SIGNIN_GOOGLE_CLIENT_ID=
SIGNIN_GOOGLE_CLIENT_SECRET=
SIGNIN_MICROSOFT_CLIENT_ID=
SIGNIN_MICROSOFT_CLIENT_SECRET=

# ---- Hosted AI (optional) ---------------------------------------------------
# With a key set, every incoming message's security review uses the hosted model, for every mailbox on this server.
# Summaries and drafts use it only for people who turn that on. No key: no mail text leaves the server for AI.
OPENAI_API_KEY=
AEGIS_LLM_MODEL=
AEGIS_LLM_BASE_URL=
# Alternative provider: used when it's the only key set, or with AEGIS_LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
AEGIS_LLM_PROVIDER=

# ---- Other options ------------------------------------------------------------
# Who can create an account. invite: the first account (you), then only addresses someone here has invited.
# open: anyone who can reach the server.
AEGIS_SIGNUP=invite
# Optional limits for every workspace on this server. Empty means no limit; the operator console can set a
# different value for one workspace. AI actions are hosted-model calls (summaries, drafts) per month.
AEGIS_LIMIT_ACCOUNTS=
AEGIS_LIMIT_AI_ACTIONS_PER_MONTH=
AEGIS_LIMIT_AUTOMATIONS=
AEGIS_LIMIT_SEATS=
AEGIS_LIMIT_INDEX_BYTES=
# "local" turns on semantic search with a small model that runs inside web and worker.
AEGIS_EMBEDDINGS=
# Shown in the Privacy Center as where data is processed, e.g. "eu-west-1".
AEGIS_REGION=
# true shows the public marketing site at /. Leave false: / then goes straight to sign-in.
AEGIS_MARKETING_SITE=false
# Platform operators, applied by `pnpm operators sync`. Comma-separated, existing verified accounts.
AEGIS_PLATFORM_ADMINS=
# Bearer token for /api/v1/metrics. Empty keeps the endpoint off.
AEGIS_METRICS_TOKEN=
# OpenTelemetry trace export from the worker.
OTEL_EXPORTER_OTLP_ENDPOINT=
WORKER_CONCURRENCY=4
# Where the web port is published. Keep loopback when a reverse proxy runs on the same host.
AEGIS_WEB_BIND=127.0.0.1
AEGIS_WEB_PORT=3000
